# --- LLM ---
# The LLM is selected per /ask request via the `llm_model` metadata field.
# Each agent's LiteLLM exposes exactly two routes:
#   - gemma4:e4b   (Ollama, served from the shared ollama container)
#   - openai/*     (wildcard pass-through to OpenAI for any gpt-*/o*/text-*)
# Anything else is rejected at the route layer with HTTP 400. Provide an
# OPENAI_API_KEY here to unlock the openai/* route.
OPENAI_API_KEY=

# --- jitter knob ---
# At /ask time, an agent compares its own measured outbound jitter against this
# threshold. Above the threshold → the agent answers without polling peers.
# Set to 0 to always allow peer help.

# --- memory tuning ---
MAX_CONTEXT_MEMORIES=40
SEARCH_LIMIT=200

# --- coordinator (driver targets this; service binds 127.0.0.1:8010 → :8000) ---
COORDINATOR_URL=http://127.0.0.1:8810

# --- neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- langfuse self-hosted ---
# Generate via the langfuse UI on first boot (http://localhost:3001) and paste here.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Random hex strings — replace with `openssl rand -hex 32` outputs.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# --- dataset URLs (consumed by the coordinator container at startup) ---
LOCOMO_DATA_URL=https://raw.githubusercontent.com/snap-research/locomo/main/data/locomo10.json
LONGMEMEVAL_DATA_URL=https://huggingface.co/datasets/xiaowu0162/longmemeval/resolve/main/longmemeval_s
