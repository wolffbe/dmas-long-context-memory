OPENAI_API_KEY=
# Optional second key. Both litellm and the judge ping-pong onto it on 429.
OPENAI_API_KEY_BACKUP=

# Edge LLM served by ollama (behind litellm proxy).
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

# The only cloud chat/completion model in the stack. Used by responder,
# judge, and the mem0/graphiti/cognee extractors.
LLM_MODEL=gpt-4o-mini
RAG_EMBED_MODEL=text-embedding-3-small

# Retrieval top_k
MEMORIES_SEARCH_LIMIT=20

# === Langfuse (self-hosted, see dmas/docker-compose.yml) ===
# NEXTAUTH_SECRET / SALT / ENCRYPTION_KEY are auto-generated on first
# `make build` if missing. Don't commit real values.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
# PUBLIC_URL is what NextAuth binds login cookies to — set to whatever
# you'll type in the browser (port-forward → http://localhost:3000,
# EC2 public hostname, custom domain).
LANGFUSE_PUBLIC_URL=http://localhost:3000
# PUBLIC_KEY / SECRET_KEY are populated by `make build` — don't fill by hand.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === Data-plane subnets ===================================================
# Three compose-managed bridges. Left blank — `make build` picks a free
# /16 and fills these in. Once written they stick around so re-running
# build doesn't shuffle subnets out from under a live deployment.
# Pin manually if you want a specific range. Each subnet is a /24;
# toxiproxy IPs must fall inside the corresponding /24.
#   EDGE_NET_SUBNET=172.30.1.0/24
#   EDGE_NET_TOXIPROXY_IP=172.30.1.10
#   CLOUD_NET_SUBNET=172.30.2.0/24
#   CLOUD_NET_TOXIPROXY_IP=172.30.2.10
#   MGMT_NET_SUBNET=172.30.3.0/24

# Other backend knobs (NEO4J_*, QDRANT_*, RAG_*, MEMORY_URL, etc.) have
# defaults baked into dmas/docker-compose.yml. Override here only if needed.
